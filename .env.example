VITE_POSTHOG_PROJECT_TOKEN=
# Spark API for partner applications. Leave empty to send them to the email-only forms worker.
VITE_SPARK_API_URL=
# Web app the webinar sign-up hands its new session to (/welcome). Defaults to production.
VITE_APP_URL=
# Cloudflare Turnstile site key, the same public key as the web app's VITE_TURNSTILE_SITE_KEY.
VITE_TURNSTILE_SITE_KEY=
# Optional onboarding-campaign token (Super Admin, no preset plan) that tags webinar sign-ups.
VITE_CHEW_WEBINAR_CAMPAIGN_TOKEN=
